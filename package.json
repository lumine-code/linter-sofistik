{
  "name": "linter-sofistik",
  "author": "lumine-code",
  "description": "Display SOFiSTiK compilation errors as linter messages.",
  "repository": "https://github.com/lumine-code/linter-sofistik",
  "bugs": {
    "url": "https://github.com/lumine-code/linter-sofistik/issues"
  },
  "keywords": [
    "cadinp",
    "structural",
    "compilation",
    "errors",
    "diagnostics"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "lib",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationHooks": [
    "language-sofistik:grammar-used"
  ],
  "providedServices": {
    "linter.provider": {
      "versions": {
        "1.0.0": "provideLinter"
      }
    }
  },
  "consumedServices": {
    "linter.registry": {
      "versions": {
        "^1.0.0": "consumeLinterRegistry"
      }
    },
    "sofistik.keywords": {
      "versions": {
        "^1.0.0": "consumeSofistikKeywords"
      }
    },
    "sofistik.environment": {
      "versions": {
        "^1.0.0": "consumeSofistikEnvironment"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
