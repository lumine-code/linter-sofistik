{
  "name": "linter-sofistik",
  "author": "lumine-code",
  "description": "Display SOFiSTiK compilation errors",
  "repository": "https://github.com/lumine-code/linter-sofistik",
  "bugs": {
    "url": "https://github.com/lumine-code/linter-sofistik/issues"
  },
  "keywords": [
    "linter",
    "sofistik"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../linter-sofistik/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationHooks": [
    "language-sofistik:grammar-used"
  ],
  "providedServices": {
    "linter": {
      "versions": {
        "1.0.0": "provideLinter"
      }
    }
  },
  "consumedServices": {
    "linter-indie": {
      "versions": {
        "^1.0.0": "consumeIndie"
      }
    },
    "sofistik.keywords": {
      "versions": {
        "^1.0.0": "consumeKeywordsService"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
